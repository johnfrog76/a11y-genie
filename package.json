{
  "name": "a11y-genie",
  "version": "0.0.0",
  "description": "An accessibility scanner for agents and people. It gives you a list of suggested improvements for your HTML: automated checks find many problems with HTML, but they are no substitute for a full accessibility audit.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "a11y-genie": "dist/cli.js"
  },
  "files": [
    "agentic/fix-loop.prompt.md",
    "schema",
    "dist",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "site": "node scripts/build-site.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.1",
    "axe-core": "4.14.1",
    "playwright-core": "1.65.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
