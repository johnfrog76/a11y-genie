{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johnfrog76/a11y-genie/schema/scan-1.json",
  "title": "A11y Genie scan.json, major version 1",
  "description": "The record `a11y-genie scan` and `a11y-genie check` write and `--json` prints. A field may be added in a minor version, never removed or renamed in one, so extra fields are allowed.",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "command",
    "exit",
    "engine",
    "target",
    "startedAt",
    "finishedAt",
    "pages",
    "summary",
    "findings",
    "needsReview",
    "ignored",
    "workflows",
    "checklist",
    "cannotSee"
  ],
  "properties": {
    "schema": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "command": { "enum": ["scan", "check"] },
    "exit": { "enum": [0, 1] },
    "engine": {
      "type": "object",
      "required": ["axeCore", "browser", "fallback", "tags", "rulesRun"],
      "properties": {
        "axeCore": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "fallback": { "type": "boolean" },
        "tags": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] },
        "rulesRun": { "type": "integer", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "required": ["origin", "commit"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "commit": { "oneOf": [{ "type": "null" }, { "type": "string" }] }
      }
    },
    "startedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "finishedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "url", "states", "notScanned"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "requestedUrl": { "type": "string", "minLength": 1 },
          "redirects": { "type": "integer", "minimum": 0 },
          "states": { "type": "array", "items": { "type": "string" } },
          "notScanned": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["state", "reason"],
              "properties": {
                "state": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "stopped": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "count", "examples"],
              "properties": {
                "kind": {
                  "enum": ["dialog", "popup", "download", "private-network", "offline", "other-origin"]
                },
                "count": { "type": "integer", "minimum": 1 },
                "examples": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "walks": { "type": "array", "items": { "$ref": "#/$defs/walk" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["critical", "serious", "moderate", "minor", "advice", "needsReview", "notScanned"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "serious": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "advice": { "type": "integer", "minimum": 0 },
        "needsReview": { "type": "integer", "minimum": 0 },
        "notScanned": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 },
        "still": { "type": "integer", "minimum": 0 },
        "fixed": { "type": "integer", "minimum": 0 },
        "sincePrevious": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["new", "fixed", "startedAt"],
              "properties": {
                "new": { "type": "integer", "minimum": 0 },
                "fixed": { "type": "integer", "minimum": 0 },
                "startedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              }
            }
          ]
        },
        "sincePreviousReason": { "type": "string", "minLength": 1 }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["path", "startedAt", "commit"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "commit": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "notScanned": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page", "state"],
            "properties": {
              "page": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "needsReview": { "type": "array", "items": { "$ref": "#/$defs/needsReview" } },
    "ignored": { "type": "array" },
    "workflows": { "type": "array" },
    "checklist": { "type": "null" },
    "cannotSee": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "options": {
      "type": "object",
      "required": ["failOn", "sameOrigin", "offline"],
      "properties": {
        "failOn": { "$ref": "#/$defs/impact" },
        "sameOrigin": { "type": "boolean" },
        "offline": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "required": ["pageSeconds", "redirects", "elementsPerFinding", "excerptChars", "scanJsonBytes"],
      "properties": {
        "pageSeconds": { "type": "number", "minimum": 0 },
        "redirects": { "type": "integer", "minimum": 0 },
        "elementsPerFinding": { "type": "integer", "minimum": 1 },
        "excerptChars": { "type": "integer", "minimum": 1 },
        "scanJsonBytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "impact": { "enum": ["critical", "serious", "moderate", "minor"] },
    "status": { "enum": ["new", "still", "fixed"] },
    "rule": {
      "type": "object",
      "required": ["source", "id", "help", "helpUrl", "wcag"],
      "properties": {
        "source": { "enum": ["axe", "genie", "manual"] },
        "id": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "helpUrl": { "type": "string" },
        "wcag": { "type": "array", "items": { "type": "string", "pattern": "^[1-4]\\.[0-9]+\\.[0-9]+$" } }
      }
    },
    "walk": {
      "description": "One state's keyboard walk (src/walk.ts), added in 1.7; `stopsCut` in 1.8.",
      "type": "object",
      "required": ["state", "stops", "end", "tabs", "maxTabs"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "stops": { "type": "array", "items": { "$ref": "#/$defs/walkStop" } },
        "end": { "enum": ["wrapped", "left", "max-tabs"] },
        "tabs": { "type": "integer", "minimum": 0 },
        "maxTabs": { "type": "integer", "minimum": 1 },
        "stopsCut": { "type": "integer", "minimum": 1 }
      }
    },
    "walkStop": {
      "type": "object",
      "required": ["index", "selector", "target", "tag", "role", "name", "focusVisible"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "tag": { "type": "string" },
        "role": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "name": { "type": "string" },
        "focusVisible": { "type": "boolean" },
        "opaque": { "const": true }
      }
    },
    "target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        ]
      }
    },
    "element": {
      "type": "object",
      "required": ["selector", "target", "html", "failure", "states"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "html": { "type": "string" },
        "failure": { "type": "string" },
        "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reason": { "type": "string" },
        "colorPair": { "$ref": "#/$defs/colorPair" },
        "status": { "$ref": "#/$defs/status" },
        "unverified": { "const": true }
      }
    },
    "colorPair": {
      "type": "object",
      "required": ["foreground", "background", "ratio", "required", "fontSize", "fontWeight"],
      "properties": {
        "foreground": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "ratio": { "type": "number", "minimum": 1 },
        "required": { "type": "number", "minimum": 1 },
        "fontSize": { "type": "string" },
        "fontWeight": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "rule", "kind", "impact", "page", "title", "plain", "fix", "elements", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^(axe|genie|manual)/.+@.+$" },
        "rule": { "$ref": "#/$defs/rule" },
        "kind": { "enum": ["violation", "advice"] },
        "impact": { "$ref": "#/$defs/impact" },
        "page": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "plain": { "type": "string", "minLength": 1 },
        "fix": { "type": "string", "minLength": 1 },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } },
        "elementsCut": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/status" },
        "fixedIn": {
          "type": "object",
          "required": ["startedAt", "commit"],
          "properties": {
            "startedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "commit": { "oneOf": [{ "type": "null" }, { "type": "string" }] }
          }
        },
        "fixedElements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } },
        "fixedCut": { "type": "integer", "minimum": 1 },
        "unverified": { "const": true }
      }
    },
    "needsReview": {
      "type": "object",
      "required": ["id", "rule", "impact", "page", "elements"],
      "properties": {
        "id": { "type": "string", "pattern": "^(axe|genie|manual)/.+@.+$" },
        "rule": { "$ref": "#/$defs/rule" },
        "impact": { "$ref": "#/$defs/impact" },
        "page": { "type": "string", "minLength": 1 },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/element", "required": ["reason"] }
        },
        "elementsCut": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
